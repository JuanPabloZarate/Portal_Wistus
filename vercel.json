{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/"
    },
    {
      "src": "/css/(.*)",
      "headers": { "cache-control": "public, max-age=86400" },
      "dest": "/css/"
    },
    {
      "src": "/js/(.*)",
      "headers": { "cache-control": "public, max-age=86400" },
      "dest": "/js/"
    },
    {
      "src": "/portal(\\.html)?",
      "dest": "/index.html"
    },
    {
      "src": "/landing(\\.html)?",
      "dest": "/landing.html"
    },
    {
      "src": "/$",
      "dest": "/landing.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
